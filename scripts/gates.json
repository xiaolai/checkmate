  "Sources/CheckmateRules/ChessRules.swift",
  "Sources/CheckmateCore/Resources/chess.js",
  "Sources/CheckmateCore/Resources/relationships.js",
  "Sources/CheckmateDomain/*",
  "Sources/CheckmateSupport/*",
  "Sources/CheckmateRules/*",
  "Sources/CheckmateComposition/*",
  "Sources/CheckmateCore/Assets.swift"
 ],
 "gates": [
  {
   "name": "architecture",
   "run": "python3 scripts/test-module-boundaries.py > \"$CHECKMATE_EVIDENCE_DIR/module-boundaries-results.json\"",
   "result": "module-boundaries-results.json",
   "key": "architecture",
   "inputs": [
    "Package.swift",
    "Sources/*",
    "Tests/*",
    "scripts/test-module-boundaries.py"
   ]
  },
  {
   "name": "ui",
   "builds": true,
   "run": "bash scripts/test-ui.sh",
   "result": "ui-results.json",
   "key": "nativeUI",
   "inputs": [
    "scripts/test-ui.sh",
    "Sources/CheckmateNative/*",
    "Sources/CheckmateCore/*",
    "Sources/CheckmateApplication/*",
    "Sources/CheckmateMacPlatform/*",
    "Sources/CheckmateEngine/*",
    "Sources/CheckmateContent/*"
   ]
  },
