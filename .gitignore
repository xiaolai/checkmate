# SwiftPM build caches (including Intel and review scratch builds)
/.build*/
/.swiftpm/

# Generated application bundles, packages and verification evidence
/build/
/evidence/
*.dSYM/
*.log

# Paid narration masters and private development records
/recordings/
/dev-docs/

# Local credentials and environment configuration
.env
.env.*

# Python caches
__pycache__/
*.py[cod]

# macOS and Xcode user state
.DS_Store
xcuserdata/
*.xcuserstate
